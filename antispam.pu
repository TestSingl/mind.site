from .. import loader, utils
import time

@loader.tds
class ChatSpamMod(loader.Module):
    """Антиспам для стикеров и гифок в одном чате с упоминанием"""
    strings = {"name": "ChatSpamMod"}

    def __init__(self):
        self.enabled = False
        self.active_chat = None  # чат, где включен антиспам

        # Настройки
        self.sticker_threshold = 6
        self.gif_threshold = 4
        self.interval = 10
        self.tags = ["@vk0ss"]  # ник(и) для упоминания

        # Данные
        self.stickers = {}  # {chat_id: {user_id: [timestamps]}}
        self.gifs = {}      # {chat_id: {user_id: [timestamps]}}

    # ---------------- Включение/выключение ----------------
    async def antispamoncmd(self, message):
        self.enabled = True
        self.active_chat = message.chat_id
        await message.edit("<b>Антиспам включён ✅</b>")

    async def antispamoffcmd(self, message):
        if self.active_chat != message.chat_id:
            await message.edit("<b>Антиспам не был включен в этом чате</b>")
            return
        self.enabled = False
        self.active_chat = None
        await message.edit("<b>Антиспам выключен ❌</b>")

    # ---------------- Настройка порогов ----------------
    async def setstickerscmd(self, message):
        if self.active_chat != message.chat_id:
            await message.edit("<b>Антиспам не включен в этом чате</b>")
            return
        args = utils.get_args(message)
        if not args or not args[0].isdigit():
            await message.edit("<b>Укажи число!</b>")
            return
        self.sticker_threshold = int(args[0])
        await message.edit(f"<b>Порог стикеров: {self.sticker_threshold}</b>")

    async def setgifscmd(self, message):
        if self.active_chat != message.chat_id:
            await message.edit("<b>Антиспам не включен в этом чате</b>")
            return
        args = utils.get_args(message)
        if not args or not args[0].isdigit():
            await message.edit("<b>Укажи число!</b>")
            return
        self.gif_threshold = int(args[0])
        await message.edit(f"<b>Порог гифок: {self.gif_threshold}</b>")

    async def setintervalcmd(self, message):
        if self.active_chat != message.chat_id:
            await message.edit("<b>Антиспам не включен в этом чате</b>")
            return
        args = utils.get_args(message)
        if not args or not args[0].isdigit():
            await message.edit("<b>Укажи число секунд!</b>")
            return
        self.interval = int(args[0])
        await message.edit(f"<b>Интервал сброса: {self.interval} сек</b>")

    # ---------------- Настройка тегов ----------------
    async def settagcmd(self, message):
        if self.active_chat != message.chat_id:
            await message.edit("<b>Антиспам не включен в этом чате</b>")
            return
        args = utils.get_args_raw(message)
        if not args:
            await message.edit("<b>Укажи хотя бы один ник!</b>")
            return
        self.tags = args.split()
        await message.edit(f"<b>Теги для упоминания: {' '.join(self.tags)}</b>")

    # ---------------- Отслеживание сообщений ----------------
    @loader.watcher()
    async def watcher(self, message):
        if not self.enabled or message.out:
            return
        if message.chat_id != self.active_chat:
            return  # игнорируем другие чаты

        chat = message.chat_id
        user = message.sender_id
        now = time.time()

        # ---------- СТИКЕРЫ ----------
        if message.sticker:
            self.stickers.setdefault(chat, {}).setdefault(user, [])
            self.stickers[chat][user].append(now)
            self.stickers[chat][user] = [t for t in self.stickers[chat][user] if now - t <= self.interval]

            if len(self.stickers[chat][user]) >= self.sticker_threshold:
                await message.reply(f"СПАМ! {' '.join(self.tags)}")
                self.stickers[chat][user] = []

        # ---------- ГИФКИ ----------
        elif message.gif:
            self.gifs.setdefault(chat, {}).setdefault(user, [])
            self.gifs[chat][user].append(now)
            self.gifs[chat][user] = [t for t in self.gifs[chat][user] if now - t <= self.interval]

            if len(self.gifs[chat][user]) >= self.gif_threshold:
                await message.reply(f"СПАМ! {' '.join(self.tags)}")
                self.gifs[chat][user] = []
